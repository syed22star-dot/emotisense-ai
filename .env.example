# EmotiSense AI — Environment Configuration
# Copy to .env for local development, or add in Render / Vercel Environment Variables.

# LLM Provider ("gemini" or "openai"; auto-detected if omitted)
LLM_PROVIDER=gemini

# Google Gemini API Key (uses Gemini 4 Hydrogen via Interactions API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Server Port (local default: 5000)
PORT=5000
FLASK_DEBUG=false
